# CMPC-libros: variables para `docker compose up --build`.
# Copia este archivo como .env. Los valores sirven para una demo local; cámbialos fuera de ella.

# --- PostgreSQL (servicio db) ---
POSTGRES_USER=cmpc
POSTGRES_PASSWORD=cmpc
POSTGRES_DB=cmpc_libros

# --- Backend ---
NODE_ENV=production
PORT=3000
# Debe coincidir con las credenciales de PostgreSQL de arriba; el host es el servicio "db".
DATABASE_URL=postgresql://cmpc:cmpc@db:5432/cmpc_libros?schema=public
# Mínimo 32 caracteres. Genera uno propio con: openssl rand -base64 48
JWT_SECRET=demo-local-reemplazar-por-un-secreto-aleatorio-de-48-bytes
JWT_EXPIRES_IN=8h
# true solo cuando la aplicación se sirve por HTTPS.
COOKIE_SECURE=false
# Origen público del frontend (nginx).
CORS_ORIGIN=http://localhost:8080
# Ruta dentro del contenedor; coincide con el volumen "uploads" de docker-compose.yml.
UPLOADS_DIR=/app/uploads

# --- Usuario administrador creado por el seed ---
SEED_ADMIN_EMAIL=admin@cmpc.cl
SEED_ADMIN_PASSWORD=Admin123!
