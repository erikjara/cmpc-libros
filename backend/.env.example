NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://cmpc:cmpc@localhost:5432/cmpc_libros?schema=public"
# Mínimo 32 caracteres. Generar uno propio: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambia-este-secreto-por-uno-de-al-menos-32-caracteres"
JWT_EXPIRES_IN=8h
# true solo detrás de HTTPS
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
UPLOADS_DIR=./uploads
SEED_ADMIN_EMAIL=admin@cmpc.cl
SEED_ADMIN_PASSWORD=Admin123!
# Datos de demostración: el seed inserta ~60 libros solo si es true y la tabla books está vacía; false en producción
SEED_DEMO_DATA=true
# Tests e2e (npm run test:e2e): usan DATABASE_URL con la base <nombre>_test (cmpc_libros_test),
# que se crea y migra sola. Para otra base, definir TEST_DATABASE_URL (debe terminar en _test).
# TEST_DATABASE_URL="postgresql://cmpc:cmpc@localhost:5432/cmpc_libros_test?schema=public"
