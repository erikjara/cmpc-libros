generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
  // relationJoins: los `include` se resuelven en una sola consulta con JOIN. Sin él,
  // Prisma lanza en paralelo una consulta por relación y, dentro de una transacción
  // (una única conexión de pg), dispara el DeprecationWarning de consultas concurrentes.
  previewFeatures     = ["partialIndexes", "relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  // Se incrementa al cerrar sesión: invalida todos los JWT emitidos (claim `tv`).
  tokenVersion Int        @default(0) @map("token_version")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  auditLogs    AuditLog[]

  @@map("users")
}

model Author {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  books     Book[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "authors_name_trgm_idx")
  @@map("authors")
}

model Publisher {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  books     Book[]

  @@map("publishers")
}

model Genre {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  books     Book[]

  @@map("genres")
}

model Book {
  id           String    @id @default(uuid()) @db.Uuid
  title        String
  // Claves de búsqueda (toSearchKey: minúsculas, sin tildes) del título y del nombre del
  // autor; las escribe la aplicación. author_search se copia en el libro para que el OR de la
  // búsqueda quede en una sola tabla y use los dos índices trigram (BitmapOr); con un filtro
  // sobre la relación, Prisma genera un LEFT JOIN que obliga a recorrer todos los libros.
  titleSearch  String    @map("title_search")
  authorSearch String    @map("author_search")
  authorId     String    @map("author_id") @db.Uuid
  publisherId  String    @map("publisher_id") @db.Uuid
  genreId      String    @map("genre_id") @db.Uuid
  price        Decimal   @db.Decimal(10, 2)
  stock        Int
  imageKey     String?   @map("image_key")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  author    Author    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  genre     Genre     @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@index([authorId])
  @@index([publisherId])
  @@index([genreId])
  // Índices parciales: el listado siempre filtra deleted_at IS NULL y ordena por estas
  // columnas; un índice compuesto (deleted_at, col) solo sirve de filtro, no de orden.
  @@index([createdAt], where: { deletedAt: null }, map: "books_active_created_at_idx")
  @@index([title], where: { deletedAt: null }, map: "books_active_title_idx")
  @@index([price], where: { deletedAt: null }, map: "books_active_price_idx")
  // Papelera: solo indexa los eliminados (pocos) y sirve al orden deleted_at DESC.
  @@index([deletedAt(sort: Desc)], where: { deletedAt: { not: null } }, map: "books_trashed_deleted_at_idx")
  @@index([titleSearch(ops: raw("gin_trgm_ops"))], type: Gin, map: "books_title_search_trgm_idx")
  @@index([authorSearch(ops: raw("gin_trgm_ops"))], type: Gin, map: "books_author_search_trgm_idx")
  @@map("books")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  EXPORT
  LOGIN

  @@map("audit_action")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  action    AuditAction
  entity    String
  entityId  String?     @map("entity_id")
  changes   Json?
  ip        String?
  userAgent String?     @map("user_agent")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
